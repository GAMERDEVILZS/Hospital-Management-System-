# MONGODB_URI: Optional MongoDB connection string (MongoDB Atlas or local mongod).
# When omitted, the server automatically runs with built-in local persistent document storage.
MONGODB_URI=""

# JWT_SECRET: Secret key used to sign staff session tokens.
JWT_SECRET="meridian-clinical-dev-secret-change-in-production"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
